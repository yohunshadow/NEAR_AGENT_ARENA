# Copy to agent/.env. Never commit .env or real keys.
# Testnet only. Do not point this at mainnet.
#
# Prefer one secret, NEAR_AGENT_KEYS_JSON, produced by scripts/deploy-testnet.sh
# at ~/.near-credentials/near-agent-arena-keys.json. When that variable is set,
# the per-agent variables below are ignored.
# NEAR_AGENT_KEYS_JSON={"contractId":"arena.testnet","rpcUrl":"https://rpc.testnet.near.org","networkId":"testnet","settler":{"accountId":"arena.testnet","privateKey":"ed25519:..."},"agents":[{"accountId":"momentum.arena.testnet","privateKey":"ed25519:..."},{"accountId":"mean-reversion.arena.testnet","privateKey":"ed25519:..."},{"accountId":"breakout.arena.testnet","privateKey":"ed25519:..."}]}

CONTRACT_ID=
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_NETWORK_ID=testnet

# Full-access or function-call keys. Production agent keys should allow only
# commit and reveal on the arena contract. The settler key calls settle and
# can be any account; it is not one of the fighter keys.
AGENT_0_ACCOUNT_ID=momentum.your-arena.testnet
AGENT_0_PRIVATE_KEY=
AGENT_1_ACCOUNT_ID=mean-reversion.your-arena.testnet
AGENT_1_PRIVATE_KEY=
AGENT_2_ACCOUNT_ID=breakout.your-arena.testnet
AGENT_2_PRIVATE_KEY=
SETTLER_ACCOUNT_ID=
SETTLER_PRIVATE_KEY=

# Optional. When NEAR_AI_API_KEY is empty the worker uses the offline strategy.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1

# Where commit salts are stored between the commit tick and the reveal tick.
STATE_DIR=.state
