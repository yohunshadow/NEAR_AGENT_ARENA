# Copy to agent/.env. Never commit .env or real keys.
# Testnet only. Do not point this at mainnet.
#
# Prefer a keys file or one JSON secret produced by scripts/deploy-testnet.sh
# (or scripts/rotate-agent-keys.sh) at ~/.near-credentials/near-agent-arena-keys.json.
# NEAR_AGENT_KEYS_FILE is read first. NEAR_AGENT_KEYS_JSON is the inline form.
# When either is set, the per-agent variables below are ignored.
# NEAR_AGENT_KEYS_FILE=/home/you/.near-credentials/near-agent-arena-keys.json
# NEAR_AGENT_KEYS_JSON={"contractId":"arena.testnet","rpcUrl":"https://rpc.testnet.near.org","networkId":"testnet","settler":{"accountId":"arena.testnet","privateKey":"ed25519:..."},"agents":[{"accountId":"momentum.arena.testnet","privateKey":"ed25519:..."},{"accountId":"mean-reversion.arena.testnet","privateKey":"ed25519:..."},{"accountId":"breakout.arena.testnet","privateKey":"ed25519:..."}]}

CONTRACT_ID=
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_NETWORK_ID=testnet
# Testnet also tries https://test.rpc.fastnear.com. Set this to off to use
# NEAR_RPC_URL only. Comma-separate extra URLs to add your own fallbacks.
# Sandbox ignores fallbacks so a local RPC is not mixed with public testnet.
# NEAR_RPC_FALLBACKS=off

# Full-access or function-call keys. Production agent keys should allow only
# commit and reveal on the arena contract. The settler key calls settle and
# can be any account; it is not one of the fighter keys.
AGENT_0_ACCOUNT_ID=momentum.your-arena.testnet
AGENT_0_PRIVATE_KEY=
AGENT_1_ACCOUNT_ID=mean-reversion.your-arena.testnet
AGENT_1_PRIVATE_KEY=
AGENT_2_ACCOUNT_ID=breakout.your-arena.testnet
AGENT_2_PRIVATE_KEY=
SETTLER_ACCOUNT_ID=
SETTLER_PRIVATE_KEY=

# Optional. When NEAR_AI_API_KEY is empty the worker uses the offline strategy.
# The OpenAI-compatible host is cloud-api.near.ai. cloud.near.ai returns 404 HTML.
# Default model is gemini-2.5-flash-lite. Some other listed models are reasoning
# models: they may leave message.content empty and put the JSON in reasoning.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=google/gemini-2.5-flash-lite

# Where commit salts are stored between the commit tick and the reveal tick.
STATE_DIR=.state

# npm run loop sleeps this long between ticks. Minimum 5000. Default 60000.
# TICK_INTERVAL_MS=60000
